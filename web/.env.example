# Copy to .env and adjust. The console is a Vite SPA — all of these are
# build-time (VITE_*) values.

# Backend API base. Defaults to http://localhost:4000 when unset.
VITE_API_BASE_URL=http://localhost:4000

# ─── Auth: Amazon Cognito hosted UI (FE-01) ─────────────────────────────────
# Leave empty for local dev (CF_DEV_AUTH=true on the server): no sign-in button
# is rendered and the server signs you in as the seeded dev user. Fill these in
# from the IN-01 Terraform outputs once the user pool exists.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=us-east-1
# Defaults to <origin>/auth/callback when unset.
VITE_COGNITO_REDIRECT_URI=
