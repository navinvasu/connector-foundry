# Hosted console build (IN-10, D-86). Dev/demo uses the AWS-generated URLs —
# branded domains are production-only (infrastructure/terraform/apps/connector-foundry/path-to-prod.md).
# Copy to .env.production, fill every value from `terraform output`, then:
#   npm run build && aws s3 sync dist/ s3://<console_bucket>/ --delete
#   aws cloudfront create-invalidation --distribution-id <console_distribution_id> --paths '/*'
VITE_API_BASE_URL=          # terraform output -raw api_url          (https://dxxxx.cloudfront.net)
VITE_COGNITO_DOMAIN=        # terraform output -raw cognito_domain   (https://connector-foundry-dev-users.auth.us-east-1.amazoncognito.com)
VITE_COGNITO_CLIENT_ID=     # terraform output -raw cognito_client_id
VITE_COGNITO_REDIRECT_URI=  # $(terraform output -raw console_url)/auth/callback
