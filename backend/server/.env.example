# Copy to .env and adjust. The server reads these at boot.
# Local (docker compose up -d in projects/connector-foundry/backend):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/connector_foundry
# AWS (RDS PostgreSQL) — same schema, just point here:
# DATABASE_URL=postgres://<user>:<password>@<rds-endpoint>:5432/connector_foundry

PORT=4000
# Release signing secret. Dev default is fine locally; set a real secret in AWS
# (Secrets Manager). Production uses KMS asymmetric signing instead.
CF_SIGNING_SECRET=dev-only-signing-secret

# ─── Auth: Amazon Cognito (console login) ─────────────────────────────────────
# Local dev: CF_DEV_AUTH=true (default) skips Cognito and signs you in as a
# seeded platform-admin dev user. Set it to false and fill in the pool values
# once the Cognito user pool exists (Terraform IN-01).
CF_DEV_AUTH=true
CF_DEV_EMAIL=dev@connectorfoundry.local
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ─── Billing: Stripe (trial → paid) ─────────────────────────────────────────
# Leave empty until you're ready to take test payments. Without
# STRIPE_SECRET_KEY the billing endpoints return 503 "not configured".
STRIPE_SECRET_KEY=
# From `stripe listen` or the dashboard webhook endpoint (signing secret).
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the customer after checkout (no trailing slash).
CONSOLE_BASE_URL=http://localhost:5174

# ─── Eval report export: S3 (EV-03) ─────────────────────────────────────────
# Leave empty until a reports bucket exists. Without all three of
# CF_REPORT_S3_BUCKET + AWS credentials, the eval-report endpoint returns
# 503 "report storage not configured". Credentials use the standard AWS
# env var names (or the instance/task role's environment in AWS).
CF_REPORT_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: AWS_SESSION_TOKEN=, CF_REPORT_S3_REGION= (else AWS_REGION, else
# us-east-1), CF_REPORT_S3_PREFIX=eval-reports, CF_REPORT_URL_TTL_SECONDS=3600

# ─── Credential vault, local dev key (AB-02) ───────────────────────────────
# Locally the broker encrypts with this 32-byte key instead of KMS.
# Generate one: openssl rand -hex 32   (64 hex chars). Without it, credential
# capture/eval-auth/invoke answer 503 credential_storage_not_configured.
# NEVER set this in a deployment — production uses CF_BROKER_KMS_KEY_ID and
# refuses to boot with a dev key (SE-07).
CF_BROKER_DEV_KEY=
CF_BROKER_KMS_KEY_ID=

# ─── Language model: Muse Spark (D-88, hackathon demo) ────────────────────
# Powers agent tasks, fix suggestions and the playground. Locally this calls
# Meta directly — no AWS involved. Without all four, those endpoints answer
# 503 llm_not_configured and the agent suite reports not_tested.
# The demo runs Muse Spark only; do not point this at Bedrock/Nova for it.
CF_LLM_PROVIDER=openai_compatible
CF_LLM_MODEL=muse-spark-1.3
CF_LLM_BASE_URL=https://api.meta.ai/v1
CF_LLM_API_KEY=
# CF_LLM_MAX_TOKENS_PER_RUN=60000

# ─── Upstream egress (SE-08) ────────────────────────────────────────────
# Server-side fetches to customer upstreams / spec URLs refuse private,
# loopback, and link-local targets (SSRF guard; redirect hops re-checked).
# CF_EGRESS_ALLOW_PRIVATE=true lifts only the address check — for local
# dev against a stub upstream on 127.0.0.1. NEVER set it in a deployment.
# CF_EGRESS_MAX_RESPONSE_BYTES caps upstream response bodies (default 5 MiB).
CF_EGRESS_ALLOW_PRIVATE=
CF_EGRESS_MAX_RESPONSE_BYTES=
