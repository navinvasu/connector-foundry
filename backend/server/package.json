{
  "name": "connector-foundry-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "tsx src/init-db.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-kms": "^3.1145.0",
    "@aws-sdk/credential-provider-node": "^3.972.84",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "pg": "^8.13.1",
    "stripe": "^22.6.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2"
  }
}
