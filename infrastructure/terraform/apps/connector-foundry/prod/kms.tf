# ─── KMS: envelope encryption for the credential broker (AB-02) ────────────
# Data keys are generated by KMS and encrypt API-key credentials; ciphertext
# lives in Postgres next to the metadata. The ECS task role may encrypt,
# decrypt, and generate data keys. Key administration is restricted to the
# identity that runs `terraform apply` (the deployer).
# (data.aws_caller_identity.current is declared in data.tf.)

resource "aws_kms_key" "credentials" {
  description             = "Envelope encryption for Connector Foundry credential broker (AB-02)"
  deletion_window_in_days = var.environment == "prod" ? 30 : 7
  enable_key_rotation     = true

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "DeployerAdmin"
        Effect = "Allow"
        Principal = {
          AWS = data.aws_caller_identity.current.arn
        }
        Action   = "kms:*"
        Resource = "*"
      },
      {
        Sid    = "BackendTaskRoleUse"
        Effect = "Allow"
        Principal = {
          AWS = aws_iam_role.backend_task.arn
        }
        Action = [
          "kms:Encrypt",
          "kms:Decrypt",
          "kms:GenerateDataKey",
          "kms:DescribeKey",
        ]
        Resource = "*"
      },
    ]
  })

  tags = { Name = "${local.name}-credentials" }
}

resource "aws_kms_alias" "credentials" {
  name          = "alias/${local.name}/credentials"
  target_key_id = aws_kms_key.credentials.key_id
}
