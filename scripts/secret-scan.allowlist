# secret-scan.allowlist — reviewed exceptions for scripts/secret-scan.sh
#
# Format (TAB-separated): <path-glob> <TAB> <pattern-name|*> <TAB> <reason>
# Paths are relative to the scan scope root (projects/connector-foundry/).
# Every entry below was individually reviewed during the SE-01 audit
# (2026-10-05); see docs/design/SE-01-repo-secret-audit.md. Do NOT add an
# entry without verifying the matched lines contain no real credential —
# when in doubt, leave the finding failing and investigate.

# The scanner's own pattern table must contain the literal private-key header.
scripts/secret-scan.sh	private_key	Scanner's own detection pattern, not a key.

# DP-05 redaction fixture table: every secret-shaped value is a fabricated
# test vector (Stripe's documented example key sk_live_TESTKEY1,
# Stripe test card 4242…, Woolworth example SSN 078-05-1120, fake xoxb token).
backend/server/src/redact.test.ts	*	DP-05 redaction fixtures; all values fabricated.

# Audit-redaction test reuses Stripe's documented example key (fabricated).
backend/server/src/db.test.ts	stripe_live_key	Stripe docs example key in a redaction test.

# DP-07 implementation: matches are doc comments describing the key format
# and function signatures (secret: string); no literal key material.
backend/server/src/gateway-keys.ts	generic_assignment	Code references secret params by name; no literals.
backend/server/src/routes/gateway-keys.ts	generic_assignment	Calls generateGatewayKeySecret(); no literal.

# Test fixtures, not credentials.
backend/server/src/eval-broker.test.ts	generic_assignment	Fixture query param api_key=query-key-9.
backend/server/src/routes/credentials.test.ts	generic_assignment	Function signature realHandle(secret: string).
backend/server/src/runtime-broker.test.ts	generic_assignment	Fixture api_key=live-key-abc.
backend/server/src/gateway-keys.test.ts	generic_assignment	Negative-test literal 'not-a-gateway-key'.
backend/server/src/mcp.test.ts	generic_assignment	Fixture uses the non-sensitive 8-char display prefix only.
backend/server/src/report.test.ts	generic_assignment	Fixture URL api_key=secret123 in a redaction test.

# OpenAPI docs example uses an ellipsis placeholder, never a real secret.
backend/server/src/api-docs.ts	generic_assignment	Docs example secret: 'cf_live_… (shown once, never stored)'.

# Built docs page (from website/docs-src/): prose describing gateway keys.
website/docs/operate.html	generic_assignment	Docs prose; no key material.

# Terraform: master_password references the random_password.db_master
# resource (generated at apply time); nothing literal is committed.
infra/aws-terraform/database.tf	generic_assignment	References random_password resource, not a literal.
